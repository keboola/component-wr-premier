{
  "type": "object",
  "title": "PREMIER Writer – Connection & Authentication",
  "required": ["host", "port", "username", "#password", "id_uj"],
  "properties": {
    "host": {
      "type": "string",
      "title": "PREMIER Host",
      "description": "PREMIER server host or IP (e.g. dev.premier.cz).",
      "propertyOrder": 1
    },
    "port": {
      "type": "integer",
      "title": "Port",
      "description": "API port (the public sandbox uses 12375).",
      "default": 443,
      "propertyOrder": 2
    },
    "use_https": {
      "type": "boolean",
      "title": "Use HTTPS",
      "description": "Connect over HTTPS. Disable only for a plain-HTTP PREMIER endpoint.",
      "propertyOrder": 3,
      "default": true
    },
    "username": {
      "type": "string",
      "title": "Username",
      "description": "PREMIER user.",
      "propertyOrder": 4
    },
    "#password": {
      "type": "string",
      "title": "Password",
      "description": "PREMIER user password.",
      "format": "password",
      "propertyOrder": 5
    },
    "id_uj": {
      "type": "string",
      "title": "Accounting Unit (ID-UJ)",
      "description": "Accounting-unit GUID sent as the ID-UJ header.",
      "propertyOrder": 6
    },
    "test_connection": {
      "type": "button",
      "format": "test-connection",
      "propertyOrder": 7,
      "options": {
        "async": {
          "label": "Test Connection",
          "action": "testConnection"
        }
      }
    },
    "max_retries": {
      "type": "integer",
      "title": "Max Retries",
      "description": "Number of API retries on transient errors.",
      "default": 5,
      "propertyOrder": 8
    }
  }
}
